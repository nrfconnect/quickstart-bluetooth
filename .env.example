# Copy to .env (in the repo root, gitignored) and fill in. Never commit real secrets.
#
# Auth: an Organization Auth Token (Bearer). Preferred — no email needed.
MEMFAULT_ORG_TOKEN=your_org_auth_token
# ... OR a User API key with your account email (HTTP Basic):
#MEMFAULT_API_EMAIL=you@nordicsemi.no
#MEMFAULT_API_KEY=your_user_api_key

# Organization slug (from the Memfault dashboard URL).
MEMFAULT_ORG_SLUG=your-org

# Project to switch TO (required) — the test asserts data lands here after switching.
MEMFAULT_PROJECT_B_SLUG=second-project
MEMFAULT_PROJECT_B_KEY=second_project_key_32_chars

# Optional baseline project, tested first (e.g. the Quickstart Shared project).
#MEMFAULT_PROJECT_A_SLUG=quickstart-shared
#MEMFAULT_PROJECT_A_KEY=UQhnIEBjXEGBCb9s1AENeAYril4WE4cj

# Optional overrides.
#MEMFAULT_DEVICE_SERIAL=87EBA6C141191A51   # auto-read from the device otherwise
#MEMFAULT_API_BASE=https://api.memfault.com
#QSBT_PORT=/dev/tty.usbmodem0010577603503
#QSBT_UPLOAD_SECONDS=20
