# App-specific Kconfig. Intentionally thin — almost all configuration lives in
# prj.conf. Add app-local options here only if they emerge.

# Report $(APPVERSION) (e.g. 1.2.3 / 1.2.3-rc1) to Memfault, not the NCS default
# $(APP_VERSION_TWEAK_STRING) (1.2.3+0). Must be a Kconfig default to expand.
config MEMFAULT_NCS_FW_VERSION
	default "$(APPVERSION)"

config QSBT_DEFAULT_PROJECT_KEY
	string "Default Memfault project key baked in at build time"
	depends on MEMFAULT_PROJECT_KEY_SETTINGS
	help
	  Optional 32-char Memfault project key applied on first boot if no key
	  has been provisioned yet via the settings shell (`settings write
	  string memfault/project_key ...`). Intended to be set at build time
	  (e.g. `-DCONFIG_QSBT_DEFAULT_PROJECT_KEY="<key>"`) so release
	  artifacts work out of the box, while a key written later via the
	  shell still overrides it on the next boot. Left empty, the device
	  ships with no key until provisioned.

source "Kconfig.zephyr"
